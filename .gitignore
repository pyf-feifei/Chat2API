# Mimo browser-login local debug artifacts (screenshots / geetest captures)
scripts/mimo-login/artifacts/
scripts/mimo-login/__pycache__/

# Pre-deploy data snapshots. These are full store exports containing every
# account's `credentials` blob (encrypted, but still the live account pool).
# Never commit them; keep them out of the repo entirely.
backups/

# Agent session transcripts exported as documents. Large, and they quote live
# config, tokens and command output from the session.
pi-session-*.html
codex-session-*.md

# One-off diagnostic scratch files. These are throwaway probes, not project
# assets; several of them transiently held live credentials (decrypted account
# cookies, Webshare API keys, Webshare proxy URLs) while a failure was being
# isolated, so they must never reach the index.
tmp-*.mjs
tmp-*.py
tmp-*.json
sd[0-9]*.txt
scratch-*.mjs
scratch-*.py
cred.json
*.patch

# Generated compression corpora. `build-corpus.mjs` and `measure-from-log.mjs`
# produce these from captured replays; they are 60MB of derived JSON and are
# reproducible, so they belong in neither the index nor a clone.
scripts/compress/tmp/

# Stray diagnostics that kept landing in the repo root. All of these are
# reproducible artefacts, and a few of them (gh_*.py scraped account data,
# tmp-wskeys) carried live credentials, so they must never be committed.
electron.vite.config.*.mjs
replay-*.mjs
tmp-wskeys*
tmp-ws-group.cjs
tmp-codex-*.log
test-*-context.cjs
dev-*.log
gh_*.py
gh_*.txt
